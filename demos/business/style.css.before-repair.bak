
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  --bg: #070a12;
  --panel: #0d1220;
  --text: #f3f6ff;
  --muted: #98a3ba;
  --blue: #6b8cff;
  --cyan: #69e4ff;
  --border: rgba(164, 185, 255, .14);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  line-height: 1.65;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 15% 15%, rgba(63, 92, 220, .12), transparent 38%),
    radial-gradient(ellipse at 85% 55%, rgba(0, 194, 255, .06), transparent 36%);
}

a {
  color: inherit;
  text-decoration: none;
}

button, input, textarea {
  font: inherit;
}

button, a {
  -webkit-tap-highlight-color: transparent;
}

button {
  cursor: pointer;
}

img, svg {
  max-width: 100%;
}

.container {
  width: min(1160px, calc(100% - 48px));
  margin-inline: auto;
}

section {
  padding: 108px 0;
}

h1, h2, h3, .logo {
  font-family: 'Space Grotesk', sans-serif;
  letter-spacing: -.045em;
}

h2 {
  font-size: clamp(2.2rem, 4.5vw, 3.6rem);
  line-height: 1.12;
}

p {
  color: var(--muted);
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #aabaff;
  font-size: .77rem;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.eyebrow::before {
  content: "";
  width: 22px;
  height: 1px;
  background: var(--cyan);
}

.section-heading {
  max-width: 660px;
  margin-bottom: 48px;
}

.section-heading p {
  max-width: 540px;
  margin-top: 18px;
  font-size: 1.02rem;
}

/* Header */

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(7, 10, 18, .82);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255, 255, 255, .06);
}

.nav-wrap {
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -.06em;
}

.logo-mark {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  color: white;
  font-size: 1.05rem;
  border-radius: 11px;
  background: linear-gradient(135deg, #7894ff, #4563e9 60%, #41d9f5);
  box-shadow: 0 0 26px rgba(92, 119, 255, .32);
}

.nav {
  display: flex;
  align-items: center;
  gap: 32px;
}

.nav a {
  color: #b2bad0;
  font-size: .9rem;
  transition: color .2s;
}

.nav a:hover {
  color: white;
}

.nav .nav-cta {
  color: white;
  padding: 11px 17px;
  border: 1px solid rgba(132, 157, 255, .45);
  border-radius: 10px;
  background: rgba(99, 125, 255, .09);
}

.menu-toggle {
  display: none;
  color: white;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 9px 12px;
}

/* Hero */

.hero {
  position: relative;
  min-height: 690px;
  display: flex;
  align-items: center;
  padding: 100px 0 115px;
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.04fr .96fr;
  align-items: center;
  gap: 36px;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

.hero h1 {
  max-width: 700px;
  font-size: clamp(3.2rem, 6.2vw, 5.65rem);
  line-height: .99;
  font-weight: 600;
}

.gradient-text {
  background: linear-gradient(100deg, #9bb0ff 5%, #6c8aff 48%, #6ce6ff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-copy > p {
  max-width: 510px;
  margin-top: 27px;
  font-size: 1.08rem;
  line-height: 1.85;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
  margin-top: 32px;
}

.btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  min-height: 49px;
  padding: 13px 21px;
  border: 1px solid transparent;
  border-radius: 11px;
  font-weight: 700;
  font-size: .91rem;
  transition: transform .25s, box-shadow .25s, border-color .25s;
}

.btn:hover {
  transform: translateY(-3px);
}

.btn-primary {
  color: white;
  background: linear-gradient(110deg, #617dff, #4b65e8);
  box-shadow: 0 8px 30px rgba(78, 103, 255, .24);
}

.btn-primary:hover {
  box-shadow: 0 12px 35px rgba(78, 103, 255, .4);
}

.btn-secondary {
  border-color: var(--border);
  background: rgba(255, 255, 255, .025);
}

.btn-secondary:hover {
  border-color: rgba(125, 153, 255, .5);
}

.hero-note {
  margin-top: 24px;
  font-size: .8rem;
  color: #77839e;
}

/* Hero visual */

.hero-visual {
  min-height: 440px;
  position: relative;
  display: grid;
  place-items: center;
  isolation: isolate;
}

.hero-glow {
  position: absolute;
  width: 330px;
  height: 330px;
  border-radius: 50%;
  background: #425dff;
  filter: blur(110px);
  opacity: .24;
  z-index: -2;
}

.orbit {
  position: absolute;
  width: 360px;
  height: 360px;
  border: 1px solid rgba(130, 160, 255, .2);
  border-radius: 50%;
  transform: rotate(-28deg) scaleY(.68);
  box-shadow: 0 0 50px rgba(89, 114, 255, .05);
}

.orbit-two {
  width: 290px;
  height: 450px;
  transform: rotate(43deg) scaleY(.8);
  border-color: rgba(101, 222, 255, .18);
}

.orbit-three {
  width: 450px;
  height: 230px;
  transform: rotate(-50deg);
  border-color: rgba(128, 144, 255, .13);
}

.core {
  width: 150px;
  height: 150px;
  display: grid;
  place-items: center;
  position: relative;
  border-radius: 35px;
  transform: rotate(-12deg);
  background: linear-gradient(145deg, rgba(108, 137, 255, .24), rgba(20, 30, 65, .82));
  border: 1px solid rgba(157, 178, 255, .55);
  box-shadow: 0 0 70px rgba(77, 103, 255, .2), inset 0 0 35px rgba(103, 132, 255, .12);
}

.core::before {
  content: "";
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(155, 183, 255, .25);
  border-radius: 26px;
}

.core span {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 3.8rem;
  font-weight: 700;
  color: #dbe6ff;
  text-shadow: 0 0 35px rgba(120, 157, 255, .85);
}

.float-card {
  position: absolute;
  min-width: 165px;
  padding: 14px 16px;
  border: 1px solid rgba(169, 190, 255, .19);
  border-radius: 14px;
  background: rgba(15, 22, 41, .84);
  backdrop-filter: blur(18px);
  box-shadow: 0 20px 50px rgba(0, 0, 0, .25);
  animation: float 5s ease-in-out infinite;
}

.float-card strong {
  display: block;
  font-size: .9rem;
}

.float-card small {
  color: #8e9bb9;
  font-size: .74rem;
}

.float-icon {
  display: inline-grid;
  place-items: center;
  width: 30px;
  height: 30px;
  margin-bottom: 7px;
  border-radius: 9px;
  color: #c5d4ff;
  background: rgba(105, 134, 255, .16);
}

.card-top {
  top: 55px;
  right: 0;
}

.card-bottom {
  bottom: 47px;
  left: 0;
  animation-delay: -2.5s;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12px); }
}

/* Trust strip */

.trust-strip {
  padding: 25px 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  background: rgba(255, 255, 255, .015);
}

.trust-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18px;
}

.trust-inner p {
  font-size: .83rem;
}

.trust-items {
  display: flex;
  flex-wrap: wrap;
  gap: 25px;
  color: #b7c2da;
  font-size: .83rem;
  font-weight: 600;
}

.trust-items span::before {
  content: "âœ¦";
  margin-right: 8px;
  color: var(--blue);
}

/* Services */

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
}

.service-card {
  position: relative;
  padding: 29px 27px;
  min-height: 255px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: linear-gradient(145deg, rgba(19, 27, 48, .82), rgba(10, 14, 25, .9));
  transition: transform .3s, border-color .3s, background .3s;
}

.service-card::after {
  content: "";
  position: absolute;
  width: 130px;
  height: 130px;
  right: -70px;
  bottom: -70px;
  background: var(--blue);
  filter: blur(65px);
  opacity: 0;
  transition: opacity .3s;
}

.service-card:hover {
  transform: translateY(-6px);
  border-color: rgba(125, 153, 255, .45);
}

.service-card:hover::after {
  opacity: .4;
}

.service-icon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  margin-bottom: 24px;
  border-radius: 14px;
  color: #b8caff;
  font-size: 1.35rem;
  background: linear-gradient(145deg, rgba(107, 140, 255, .2), rgba(75, 101, 232, .06));
  border: 1px solid rgba(123, 149, 255, .19);
}

.service-card h3 {
  margin-bottom: 10px;
  font-size: 1.22rem;
}

.service-card p {
  font-size: .91rem;
  line-height: 1.8;
}

/* About */

.about {
  border-top: 1px solid rgba(255, 255, 255, .04);
  border-bottom: 1px solid rgba(255, 255, 255, .04);
  background: linear-gradient(110deg, rgba(15, 21, 37, .65), rgba(7, 10, 18, .25));
}

.about-grid {
  display: grid;
  grid-template-columns: .95fr 1.05fr;
  align-items: center;
  gap: 80px;
}

.about-visual {
  min-height: 390px;
  position: relative;
  display: grid;
  place-items: center;
  overflow: hidden;
  border-radius: 24px;
  border: 1px solid var(--border);
  background:
    linear-gradient(rgba(111, 139, 255, .045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(111, 139, 255, .045) 1px, transparent 1px),
    radial-gradient(circle at center, rgba(67, 92, 231, .19), transparent 65%),
    #0b1020;
  background-size: 28px 28px, 28px 28px, auto, auto;
}

.about-orb {
  width: 180px;
  height: 180px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 3.4rem;
  font-weight: 700;
  background: radial-gradient(circle at 30% 25%, #859cff, #3349b9 55%, #111b49);
  box-shadow: 0 0 75px rgba(87, 113, 255, .35), inset 0 0 25px rgba(255, 255, 255, .18);
  border: 1px solid rgba(180, 196, 255, .5);
}

.about-orb::after {
  content: "";
  position: absolute;
  width: 260px;
  height: 260px;
  border: 1px solid rgba(139, 164, 255, .3);
  border-radius: 50%;
}

.about-copy > p {
  margin-top: 21px;
  line-height: 1.9;
}

.about-points {
  display: grid;
  gap: 15px;
  margin-top: 28px;
}

.about-point {
  display: flex;
  gap: 13px;
  align-items: flex-start;
}

.check-icon {
  flex: 0 0 25px;
  height: 25px;
  display: grid;
  place-items: center;
  margin-top: 2px;
  border-radius: 50%;
  color: #9fb2ff;
  background: rgba(105, 134, 255, .15);
}

.about-point strong {
  display: block;
  margin-bottom: 3px;
  font-size: .94rem;
}

.about-point p {
  font-size: .85rem;
}

/* Process */

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.step {
  padding-top: 22px;
  border-top: 1px solid rgba(126, 151, 255, .3);
}

.step-number {
  color: #8299ff;
  font-size: .8rem;
  font-weight: 700;
  letter-spacing: .12em;
}

.step h3 {
  margin: 14px 0 9px;
  font-size: 1.15rem;
}

.step p {
  font-size: .88rem;
  line-height: 1.8;
}

/* CTA */

.cta-band {
  position: relative;
  padding: 58px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  overflow: hidden;
  border: 1px solid rgba(126, 151, 255, .3);
  border-radius: 24px;
  background:
    radial-gradient(ellipse at 80% 10%, rgba(70, 110, 255, .25), transparent 45%),
    linear-gradient(120deg, #111a35, #0c1224);
}

.cta-band h2 {
  max-width: 620px;
  font-size: clamp(2rem, 4vw, 3rem);
}

.cta-band p {
  max-width: 560px;
  margin-top: 13px;
}

/* Contact */

.contact-grid {
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  gap: 70px;
}

.contact-copy > p {
  margin-top: 20px;
  line-height: 1.9;
}

.contact-email {
  display: inline-block;
  margin-top: 26px;
  color: #b9c8ff;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.contact-form {
  padding: 30px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: linear-gradient(145deg, rgba(18, 26, 46, .9), rgba(10, 14, 25, .95));
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.form-field {
  display: grid;
  gap: 8px;
  margin-bottom: 18px;
}

.form-field label {
  color: #dbe3f6;
  font-size: .85rem;
  font-weight: 600;
}

.form-field input,
.form-field textarea,
.form-field select {
  width: 100%;
  color: var(--text);
  background: rgba(5, 8, 16, .65);
  border: 1px solid rgba(158, 178, 255, .17);
  border-radius: 10px;
  padding: 13px 14px;
  outline: none;
  transition: border-color .2s, box-shadow .2s;
}

.form-field input:focus,
.form-field textarea:focus,
.form-field select:focus {
  border-color: #718bff;
  box-shadow: 0 0 0 3px rgba(107, 140, 255, .1);
}

.form-field textarea {
  min-height: 125px;
  resize: vertical;
}

.form-field select option {
  background: #0d1220;
}

.form-message {
  min-height: 24px;
  margin-top: 12px;
  font-size: .84rem;
  overflow-wrap: anywhere;
}

.form-message.success {
  color: #9beac5;
}

.form-message.error {
  color: #ffb5b5;
}

/* Footer */

footer {
  padding: 28px 0;
  border-top: 1px solid var(--border);
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.footer-inner p {
  font-size: .82rem;
}

.footer-links {
  display: flex;
  gap: 20px;
  color: #a5b0c7;
  font-size: .85rem;
}

.footer-links a:hover {
  color: white;
}

/* Scroll reveal */

.reveal {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity .7s ease, transform .7s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* Responsive */

@media (max-width: 950px) {
  section {
    padding: 85px 0;
  }

  .hero {
    min-height: auto;
    padding: 80px 0;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .hero-copy {
    max-width: 720px;
  }

  .hero-visual {
    min-height: 390px;
  }

  .services-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-grid {
    gap: 40px;
  }

  .contact-grid {
    gap: 35px;
  }

  .cta-band {
    padding: 42px;
  }
}

@media (max-width: 700px) {
  .container {
    width: min(100% - 34px, 560px);
  }

  section {
    padding: 72px 0;
  }

  .nav-wrap {
    min-height: 72px;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .nav {
    display: none;
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    right: 0;
    padding: 22px 24px 26px;
    flex-direction: column;
    align-items: stretch;
    gap: 18px;
    background: rgba(8, 12, 23, .98);
    border-bottom: 1px solid var(--border);
  }

  .nav.open {
    display: flex;
  }

  .nav a {
    padding: 4px 0;
  }

  .nav .nav-cta {
    text-align: center;
  }

  .hero {
    padding: 72px 0 45px;
  }

  .hero h1 {
    font-size: clamp(2.85rem, 13vw, 4.5rem);
  }

  .hero-copy > p {
    font-size: 1rem;
  }

  .hero-visual {
    min-height: 330px;
    transform: scale(.9);
    margin: -4px -15px;
  }

  .orbit {
    width: 300px;
    height: 300px;
  }

  .orbit-two {
    width: 240px;
    height: 370px;
  }

  .orbit-three {
    width: 350px;
    height: 190px;
  }

  .core {
    width: 125px;
    height: 125px;
  }

  .core span {
    font-size: 3.2rem;
  }

  .float-card {
    min-width: 140px;
    padding: 11px 12px;
  }

  .card-top {
    top: 28px;
    right: -4px;
  }

  .card-bottom {
    bottom: 25px;
    left: -4px;
  }

  .trust-inner {
    align-items: flex-start;
    flex-direction: column;
  }

  .trust-items {
    gap: 12px 18px;
  }

  .services-grid {
    grid-template-columns: 1fr;
  }

  .service-card {
    min-height: auto;
  }

  .about-grid,
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 34px;
  }

  .about-visual {
    min-height: 300px;
  }

  .about-orb {
    width: 145px;
    height: 145px;
    font-size: 2.8rem;
  }

  .steps {
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 18px;
  }

  .cta-band {
    padding: 30px 24px;
    flex-direction: column;
    align-items: flex-start;
  }

  .contact-form {
    padding: 22px 17px;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .footer-inner {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 380px) {
  .hero-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .hero-actions .btn {
    width: 100%;
  }

  .hero-visual {
    transform: scale(.78);
    margin: -25px -35px;
  }

  .steps {
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}

/* NEXORA layout alignment fix */
html,
body {
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

.container {
  width: min(1160px, calc(100% - 48px));
  margin-left: auto;
  margin-right: auto;
}

.hero,
.hero-grid,
section,
header,
footer {
  max-width: 100%;
}

.hero-grid > *,
.about-grid > *,
.contact-grid > * {
  min-width: 0;
}

.hero h1 {
  overflow-wrap: break-word;
}

@media (max-width: 700px) {
  .container {
    width: calc(100% - 34px);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 10vw, 4rem);
  }
}

/* NEXORA â€” Premium dark contact form */
.contact-form input,
.contact-form textarea,
.contact-form select {
  width: 100%;
  background: #0a1020 !important;
  color: #f3f6ff !important;
  border: 1px solid rgba(129, 153, 255, 0.24) !important;
  border-radius: 10px;
  padding: 14px 16px;
  outline: none;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.92rem;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

.contact-form input::placeholder,
.contact-form textarea::placeholder {
  color: #7f8ba8 !important;
  opacity: 1;
}

.contact-form input:focus,
.contact-form textarea:focus,
.contact-form select:focus {
  background: #0c1428 !important;
  border-color: #718bff !important;
  box-shadow: 0 0 0 3px rgba(107, 140, 255, 0.12),
              0 0 22px rgba(85, 111, 255, 0.08);
}

.contact-form select {
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
}

.contact-form select option {
  background: #0d1220;
  color: #f3f6ff;
}

.contact-form textarea {
  min-height: 130px;
  resize: vertical;
}

.contact-form input:-webkit-autofill,
.contact-form input:-webkit-autofill:hover,
.contact-form input:-webkit-autofill:focus {
  -webkit-text-fill-color: #f3f6ff;
  -webkit-box-shadow: 0 0 0 1000px #0a1020 inset;
  transition: background-color 9999s ease-in-out 0s;
}

/* NEXORA â€” Better page spacing */
.container {
  width: calc(100% - 80px);
  max-width: 1160px;
  margin-left: auto;
  margin-right: auto;
}

@media (max-width: 700px) {
  .container {
    width: calc(100% - 36px);
  }
}

@media (min-width: 1400px) {
  .container {
    width: calc(100% - 120px);
    max-width: 1240px;
  }
}

/* NEXORA â€” Global alignment correction */
header .container,
section .container,
footer .container,
.trust-strip .container {
  width: calc(100% - 100px) !important;
  max-width: 1240px !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

@media (max-width: 700px) {
  header .container,
  section .container,
  footer .container,
  .trust-strip .container {
    width: calc(100% - 36px) !important;
  }
}

/* NEXORA header â€” alignment and logo fix */
.header {
  width: 100%;
  max-width: 100%;
  padding: 0 clamp(24px, 5vw, 76px);
  margin: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.header .logo {
  flex-shrink: 0;
  margin: 0;
  white-space: nowrap;
  overflow: visible;
}

.header .logo-icon {
  flex-shrink: 0;
}

.header .nav {
  margin-left: auto;
  min-width: 0;
}

@media (max-width: 700px) {
  .header {
    padding: 0 18px;
  }

  .header .nav {
    margin-left: 0;
  }
}

/* NEXORA responsive hero refinement */
.hero-grid {
  width: 100%;
  grid-template-columns: minmax(0, 1.08fr) minmax(300px, .92fr);
  align-items: center;
  gap: clamp(20px, 2.5vw, 36px);
}

.hero-copy {
  position: relative;
  z-index: 2;
  min-width: 0;
}

.hero h1 {
  max-width: 700px;
  font-size: clamp(2.8rem, 5vw, 4.8rem);
  line-height: 1.06;
  overflow-wrap: break-word;
}

.hero-copy > p {
  max-width: 500px;
}

.hero-visual {
  position: relative;
  min-width: 0;
  width: 100%;
  min-height: 440px;
  margin: 0;
  transform: none;
}

.hero-bottom {
  position: relative;
  z-index: 3;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px 24px;
}

.hero-bottom > * {
  min-width: 0;
}

@media (max-width: 950px) {
  .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .hero-copy {
    max-width: 720px;
  }

  .hero-visual {
    min-height: 340px;
  }

  .visual-label {
    display: none;
  }
}

@media (max-width: 700px) {
  .hero h1 {
    font-size: clamp(2.4rem, 9vw, 3.6rem);
    line-height: 1.08;
  }

  .hero-visual {
    min-height: 290px;
    transform: scale(.82);
    transform-origin: left top;
    width: 122%;
    margin-bottom: -45px;
  }

  .hero-bottom {
    font-size: .72rem;
  }
}

/* NEXORA — Mobile layout fix */
@media (max-width: 700px) {
  .container,
  header .container,
  section .container,
  footer .container,
  .trust-strip .container {
    width: calc(100% - 36px) !important;
    max-width: 100% !important;
  }

  .hero {
    min-height: auto;
    padding: 60px 0 35px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    gap: 12px;
  }

  .hero-copy,
  .hero-copy > p {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .hero h1 {
    max-width: 100%;
    font-size: clamp(2.25rem, 9vw, 3.3rem);
    line-height: 1.08;
    overflow-wrap: anywhere;
  }

  .hero-visual {
    width: 100%;
    min-width: 0;
    min-height: 290px;
    margin: 0;
    transform: none;
    overflow: hidden;
  }

  .orbit {
    max-width: 100%;
  }

  .hero-bottom {
    width: 100%;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-bottom > * {
    min-width: 0;
    max-width: 100%;
  }

  .hero-actions .btn {
    max-width: 100%;
  }
}
